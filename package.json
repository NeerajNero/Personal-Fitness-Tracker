{
  "name": "calorie-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed": "node --env-file=.env --import=tsx scripts/seed.ts",
    "bot:set-webhook": "node --env-file=.env --import=tsx scripts/bot-webhook.ts set",
    "bot:webhook-info": "node --env-file=.env --import=tsx scripts/bot-webhook.ts info",
    "bot:delete-webhook": "node --env-file=.env --import=tsx scripts/bot-webhook.ts delete",
    "tick": "node --env-file=.env --import=tsx scripts/tick.ts",
    "tick:dry": "node --env-file=.env --import=tsx scripts/tick.ts dry"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@neondatabase/serverless": "^1.2.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "grammy": "^1.46.0",
    "next": "16.4.0",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.0"
}
