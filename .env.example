# Neon Postgres connection string (Neon console → project → Connection details; use the pooled URL)
DATABASE_URL=
# Auth.js session secret — generate with `openssl rand -base64 32`
AUTH_SECRET=
# Google OAuth client ID (Google Cloud console → APIs & Services → Credentials → OAuth 2.0 Client)
AUTH_GOOGLE_ID=
# Google OAuth client secret (same credential as AUTH_GOOGLE_ID)
AUTH_GOOGLE_SECRET=
# The single Google account email allowed to sign in (the owner)
ALLOWED_EMAIL=
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Bot username without the @ (shown in onboarding as the link target); not a secret
TELEGRAM_BOT_USERNAME=
# Random secret passed to setWebhook as secret_token; verified on /api/telegram — `openssl rand -hex 32`
TELEGRAM_WEBHOOK_SECRET=
# Shared secret sent as x-tick-secret header by cron-job.org to /api/tick — `openssl rand -hex 32`
TICK_SECRET=
# Gemini API key (Google AI Studio → Get API key)
GEMINI_API_KEY=
# Public base URL of the deployed app, no trailing slash (e.g. https://recomp.vercel.app)
NEXT_PUBLIC_APP_URL=
